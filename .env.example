# AI Deduplicator — environment for the OPTIONAL AI mode (ai-deduplicate).
# The FREE content-hash mode (`deduplicate`) needs NONE of this.
# Copy to `.env` and fill in only the backend you use. Never commit your real .env.

# --- Option A: OpenAI (paid) ---
# Used by `ai-deduplicate` when --use-lm-studio is NOT set and a key is present.
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Option B: LM Studio (free, local) ---
# Used by `ai-deduplicate --use-lm-studio`. Point this at your LM Studio server.
# You can also override at runtime with --lm-studio-url, or in .deduplication_config.json.
LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions
LM_STUDIO_MODEL=gemma-3-27b-it
